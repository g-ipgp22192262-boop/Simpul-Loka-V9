/** PBD integration. Copy this file AND PbdModel.gs into the existing V9 Apps Script.
 * No real Sheet/URL/password is bundled. setupPbdRecords() must be run by owner.
 */
function pbdFail_(message,status){const e=Error(message);e.status=status||400;throw e;}
function pbdEnabled_(){if(PropertiesService.getScriptProperties().getProperty('PBD_ENABLED')!=='true')pbdFail_('Integrasi PBD belum dikonfigurasi.',503);}
function pbdLock_(fn){const l=LockService.getScriptLock();l.waitLock(20000);try{return fn();}finally{l.releaseLock();}}
function setupPbdRecords(){return pbdLock_(()=>{const props=PropertiesService.getScriptProperties(),id=props.getProperty('SPREADSHEET_ID');if(!id)throw Error('Jalankan setupSimpulLoka dahulu pada spreadsheet ujian kosong.');const ss=SpreadsheetApp.openById(id);for(const[name,head]of [['Ringkasan PBD',PbdModel.summaryHeaders],['Butiran Loka',PbdModel.detailHeaders]]){const sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0)sh.appendRow(head);else{const h=sh.getRange(1,1,1,head.length).getValues()[0];if(h.some((v,i)=>v!==head[i]))throw Error('Skema '+name+' tidak sepadan. Data tidak dipadam.');}sh.setFrozenRows(1);if(name==='Ringkasan PBD')sh.hideColumns(18);}props.setProperty('PBD_ENABLED','true');return 'Dua tab PBD disediakan. Tiada data murid dicipta.';});}
function pbdValues_(name){const s=sheet_(name);if(!s)pbdFail_('Tab PBD belum tersedia.',503);return s.getDataRange().getValues().slice(1).map((data,i)=>({data,row:i+2}));}
function pbdIso_(date,time){const [d,m,y]=String(date).split('/');return new Date(`${y}-${m}-${d}T${time}+08:00`).toISOString();}
function pbdLoad_(id){const student=rows_('Murid').find(x=>x.obj.studentId===id)?.obj;if(!student)pbdFail_('Rekod tidak ditemui.',404);const matches=pbdValues_('Ringkasan PBD').filter(x=>x.data[17]===id);if(matches.length>1)pbdFail_('Duplikasi rekod perlu disemak pentadbir.',409);const r=PbdModel.newRecord(student,new Date().toISOString());if(matches[0]){const v=matches[0].data;r.startedAt=pbdIso_(v[0],v[1]);r.updatedAt=pbdIso_(String(v[16]).split(' ')[0],String(v[16]).split(' ')[1]);r.completed=[1,2,3,4,5,6].filter(n=>v[n+3]==='Selesai');}const used=new Set();for(const{data:v}of pbdValues_('Butiran Loka').filter(x=>x.data[0]===id)){if(used.has(v[1]))pbdFail_('Duplikasi sesi perlu disemak pentadbir.',409);used.add(v[1]);r.attempts.push({runId:v[1],lokaId:Number(v[2]),startedAt:pbdIso_(v[6],v[7]),endedAt:v[8]?pbdIso_(String(v[8]).split(' ')[0],String(v[8]).split(' ')[1]):null,completed:String(v[9]).toLowerCase()==='true',presented:String(v[20]).toLowerCase()==='true',responses:JSON.parse(v[11]||'[]'),obj2:v[13]||'Belum Dinilai',oral:v[14]===''?null:Number(v[14]),written:v[15]===''?null:Number(v[15]),rubric:JSON.parse(v[16]||'[null,null,null,null,null]'),note:v[17]||'',assessedAt:Number(v[19])?v[18]:null,assessmentHistory:JSON.parse(v[21]||'[]'),assessmentVersion:Number(v[19])||0});}return r;}
function pbdCellText_(value){if(typeof value!=='string')return value;return /^[=+@-]/.test(value)?"'"+value:value;}
function pbdSave_(r){const details=sheet_('Butiran Loka'),old=pbdValues_('Butiran Loka').filter(x=>x.data[0]===r.recordId);for(const row of PbdModel.sheetDetails(r)){const match=old.filter(x=>x.data[1]===row[1]);if(match.length>1)pbdFail_('Duplikasi sesi.',409);details.getRange(match[0]?.row||details.getLastRow()+1,1,1,row.length).setNumberFormat('@').setValues([row.map(pbdCellText_)]);}const sh=sheet_('Ringkasan PBD'),found=pbdValues_('Ringkasan PBD').filter(x=>x.data[17]===r.recordId);if(found.length>1)pbdFail_('Duplikasi rekod.',409);const row=PbdModel.sheetSummary(r);sh.getRange(found[0]?.row||sh.getLastRow()+1,1,1,row.length).setNumberFormat('@').setValues([row.map(pbdCellText_)]);}
function pbdStudent(studentId,token,op,payload){pbdEnabled_();student_(studentId,token);return pbdLock_(()=>{const r=pbdLoad_(studentId),now=new Date().toISOString(),p=payload||{},progress=rows_('KemajuanLoka').filter(x=>x.obj.studentId===studentId).map(x=>x.obj);if(op==='start')PbdModel.start(r,p.lokaId,p.runId,now);else if(op==='response')PbdModel.respond(r,p.runId,p,now);else if(op!=='sync'&&op!=='told')pbdFail_('Operasi murid tidak sah.');PbdModel.sync(r,progress,now,p.runId,op==='told');pbdSave_(r);return {saved:true,source:'google-sheets'};});}
// Durable Script Properties + LockService: shared across gateway instances, not an in-memory rate limiter.
function pbdAuthCleanup_(props,now){for(const[k,v]of Object.entries(props.getProperties()))if(/^(SGC_|SGS_|SGR_)/.test(k)){try{if(JSON.parse(v).expiresAt<=now)props.deleteProperty(k);}catch{props.deleteProperty(k);}}}
function pbdAuthAttempt(clientKey){pbdEnabled_();if(!/^[a-f0-9]{64}$/.test(clientKey))pbdFail_('Permintaan tidak sah.');return pbdLock_(()=>{const props=PropertiesService.getScriptProperties(),now=Date.now();pbdAuthCleanup_(props,now);for(const[key,max]of [['SGR_'+clientKey,5],['SGR_global',50]]){const old=JSON.parse(props.getProperty(key)||'null')||{count:0,expiresAt:now+900000};if(old.count>=max)pbdFail_('Terlalu banyak percubaan. Cuba semula selepas 15 minit.',429);}for(const key of ['SGR_'+clientKey,'SGR_global']){const old=JSON.parse(props.getProperty(key)||'null')||{count:0,expiresAt:now+900000};old.count++;props.setProperty(key,JSON.stringify(old));}const nonce=Utilities.getUuid();props.setProperty('SGC_'+nonce,JSON.stringify({clientKey,expiresAt:now+60000}));return {nonce};});}
function pbdAuthFinish(nonce,clientKey,verified,tokenHash){pbdEnabled_();return pbdLock_(()=>{const props=PropertiesService.getScriptProperties(),key='SGC_'+nonce,challenge=JSON.parse(props.getProperty(key)||'null');props.deleteProperty(key);if(!challenge||challenge.expiresAt<=Date.now()||challenge.clientKey!==clientKey)pbdFail_('Permintaan log masuk tamat. Cuba lagi.',401);if(verified!==true)pbdFail_('Kod laluan tidak sah.',401);if(!/^[a-f0-9]{64}$/.test(tokenHash))pbdFail_('Sesi tidak sah.');pbdAuthCleanup_(props,Date.now());if(Object.keys(props.getProperties()).filter(k=>k.startsWith('SGS_')).length>=30)pbdFail_('Had sesi guru dicapai. Cuba kemudian.',429);const expiresAt=Date.now()+1800000;props.setProperty('SGS_'+tokenHash,JSON.stringify({expiresAt}));return {expiresAt};});}
function pbdSession_(tokenHash){pbdEnabled_();if(!/^[a-f0-9]{64}$/.test(String(tokenHash)))pbdFail_('Sila log masuk.',401);const props=PropertiesService.getScriptProperties(),s=JSON.parse(props.getProperty('SGS_'+tokenHash)||'null');if(!s||s.expiresAt<=Date.now()){props.deleteProperty('SGS_'+tokenHash);pbdFail_('Sesi tamat. Sila log masuk semula.',401);}return s;}
function pbdAuthStatus(tokenHash){const s=pbdSession_(tokenHash);return {expiresAt:s.expiresAt};}
function pbdAuthLogout(tokenHash){pbdEnabled_();if(/^[a-f0-9]{64}$/.test(String(tokenHash)))PropertiesService.getScriptProperties().deleteProperty('SGS_'+tokenHash);return {loggedOut:true};}
function pbdTeacherList(tokenHash){pbdSession_(tokenHash);return pbdLock_(()=>{pbdSession_(tokenHash);const ids=[...new Set(pbdValues_('Ringkasan PBD').map(x=>x.data[17]))];if(ids.length>500)pbdFail_('Had paparan 500 rekod. Pentadbir perlu mengarkib sesi lama.',413);const records=[];let size=0;for(const id of ids){const record=PbdModel.summary(pbdLoad_(id));size+=JSON.stringify(record).length;if(size>1000000)pbdFail_('Had saiz paparan rekod dicapai. Pentadbir perlu mengarkib sesi lama.',413);records.push(record);}return {source:'google-sheets',records};});}
function pbdTeacherAssess(tokenHash,recordId,runId,input){pbdSession_(tokenHash);return pbdLock_(()=>{pbdSession_(tokenHash);const r=pbdLoad_(recordId);PbdModel.assess(r,runId,input,new Date().toISOString());pbdSave_(r);return {source:'google-sheets',record:PbdModel.summary(r),saved:true};});}
function pbdTicketPermit_(clientKey){if(PropertiesService.getScriptProperties().getProperty('PBD_ENABLED')!=='true')return;if(!/^[a-f0-9]{64}$/.test(String(clientKey)))pbdFail_('Gateway tiket perlu dikemas kini.',503);return pbdLock_(()=>{const props=PropertiesService.getScriptProperties(),now=Date.now();pbdAuthCleanup_(props,now);for(const[key,max]of [['SGR_ticket_'+clientKey,60],['SGR_ticket_global',500]]){const v=JSON.parse(props.getProperty(key)||'null')||{count:0,expiresAt:now+3600000};if(v.count>=max)pbdFail_('Had tiket sementara dicapai. Hubungi guru atau cuba kemudian.',429);}for(const key of ['SGR_ticket_'+clientKey,'SGR_ticket_global']){const v=JSON.parse(props.getProperty(key)||'null')||{count:0,expiresAt:now+3600000};v.count++;props.setProperty(key,JSON.stringify(v));}});}
function revokePbdTeacherSessions(){return pbdLock_(()=>{const p=PropertiesService.getScriptProperties();for(const k of Object.keys(p.getProperties()))if(k.startsWith('SGS_')||k.startsWith('SGC_'))p.deleteProperty(k);return 'Semua sesi guru dibatalkan.';});}
