# Names only. Copy to ignored .env.pbd.local and fill privately; no fabricated credentials/URLs.
APPS_SCRIPT_URL=
APPS_SCRIPT_PROXY_SECRET=
PBD_PASSCODE_HASH=
PBD_GATEWAY_ENABLED=false
# Optional direct Google Sheet link shown only after teacher login.
PBD_SHEET_URL=
# Required HTTPS origin for future production; local dev-server sets its real loopback origin.
PBD_SITE_ORIGIN=
PBD_LOCAL_HTTP=0
PBD_SIMULATION=0
PBD_PORT=4180
